{
  "@context": "https://bgiesbrecht.github.io/tessera/spec/v0/context.jsonld",
  "@type": "RetentionConstraint",
  "@id": "policy:retention-orders-delete-after-30d",
  "version": "1.0.0",
  "description": "Rows of acme.tpch.orders must be purged 30 days after o_orderdate (data minimization). Direction delete-after; basis the o_orderdate column; disposition Purge. Expressed and validated in v0; not emitted as enforcement.",
  "appliesTo": {
    "selector": "byIdentity",
    "resource": "table:acme.tpch.orders"
  },
  "retention": {
    "direction": "DeleteAfter",
    "period": "P30D",
    "basis": "column:acme.tpch.orders.o_orderdate",
    "disposition": "Purge"
  },
  "capabilityRequirements": [
    "retention-expression"
  ],
  "provenance": {
    "notes": "Worked example for ADR-031 (RetentionConstraint, expression-first). Shows the\ntwo-directional model (delete-after here; retain-for is the mirror) and the\nbasis/disposition parameters. No adapter emission — retention has no\ndeclarative platform primitive; emitted enforcement (a scheduled job) is a\ndeferred, opt-in, driver-led increment."
  }
}
