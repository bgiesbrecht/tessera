{
  "@context": "https://bgiesbrecht.github.io/tessera/spec/v0/context.jsonld",
  "@type": "Policy",
  "@id": "policy:analysts-tiering",
  "version": "1.0.0",
  "policyKind": "RowVisibilityConstraint",
  "description": "Two distinct analyst tiers on a separate table \u2014 no overlap, no dead rules.",
  "appliesTo": {
    "selector": "byIdentity",
    "resource": "table:acme.tpch.customers"
  },
  "action": "Read",
  "defaultStrategy": "none",
  "rules": [
    {
      "principal": {
        "selector": "byIdentity",
        "resource": "group:acme_analysts_tier1"
      },
      "effect": "keep-matching-rows",
      "condition": {
        "op": "in",
        "operands": [
          "column:acme.tpch.customers.segment"
        ],
        "values": [
          "ENTERPRISE"
        ]
      }
    },
    {
      "principal": {
        "selector": "byIdentity",
        "resource": "group:acme_analysts_tier2"
      },
      "effect": "keep-matching-rows",
      "condition": {
        "op": "in",
        "operands": [
          "column:acme.tpch.customers.segment"
        ],
        "values": [
          "SMB"
        ]
      }
    }
  ]
}
